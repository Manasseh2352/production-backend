# Copy this file to `.env` and fill in real values. NEVER commit `.env` or real
# secrets. This example must contain placeholders only.

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── Database (PostgreSQL / Neon) ──────────────────────────
# Read by Prisma (see prisma/schema.prisma `datasource db { url = env(...) }`).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ── Auth (JWT) ────────────────────────────────────────────
# Use long, random values, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# ── AI microservice ───────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=8000

# ── Email / OTP delivery (SMTP) ───────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL="AgriMarket <no-reply@example.com>"

# ── OTP debug bypass (DEV ONLY — keep false in production) ─
OTP_DEBUG_BYPASS=false
OTP_DEBUG_BYPASS_CODE=123456

# ── ImageKit (image uploads) ──────────────────────────────
# Server-side uploads authenticate with the private key alone.
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
